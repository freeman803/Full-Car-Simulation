[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             = 3.0
FILE_FORMAT              ='ASCII'
$----------------------------------------------------------------units
[UNITS]
LENGTH              = 'meter'
FORCE               = 'newton'
ANGLE               = 'radians'
MASS                = 'kg'
TIME                = 'second'
$----------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT     ='PAC2002'
USE_MODE                 = 4                    $Tyre use switch (IUSED)
VXLOW                    = 1            
LONGVL                   = 11.17600          $Measurement speed 
TYRESIDE                 = 'RIGHT'              $Mounted side of tyre at vehicle/test bench
$-----------------------------------------------------------dimensions
[DIMENSION]
UNLOADED_RADIUS          = 0.2032              $Free tyre radius 
WIDTH                    = 0.1905             $Nominal section width of the tyre 
ASPECT_RATIO             = 0.4               $Nominal aspect ratio
RIM_RADIUS               = 0.127               $Nominal rim radius 
RIM_WIDTH                = 0.1778              $Rim width 
$----------------------------------------------------------------shape
[SHAPE]
{radial width}
 1.0    0.0 
 1.0    0.4 
 1.0    0.9 
 0.9    1.0 
$------------------------------------------------------------parameter
[VERTICAL]
VERTICAL_STIFFNESS       = 85000            $Tyre vertical stiffness 
VERTICAL_DAMPING         = 500                  $Tyre vertical damping       
BREFF                    = 3.5                  $Low load stiffness e.r.r.     
DREFF                    = 0.5                  $Peak value of e.r.r.     
FREFF                    = -0.005               $High load stiffness e.r.r.     
FNOMIN                   = 889.64430              $Nominal wheel load
$------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -0.53              $Minimum valid wheel slip
KPUMAX                   = 0.35              $Maximum valid wheel slip
$-----------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -0.35              $Minimum valid slip angle
ALPMAX                   = 0.35              $Maximum valid slip angle
$-----------------------------------------------inclination_slip_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.09              $Minimum valid camber angle
CAMMAX                   = 0.09              $Maximum valid camber angle
$-------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 0                $Minimum allowed wheel load
FZMAX                    = 10000               $Maximum allowed wheel load
$--------------------------------------------------------------scaling
[SCALING_COEFFICIENTS]
 LFZ0                    = 1                     $Scale factor of nominal (rated) load
 LCX                     = 1                     $Scale factor of Fx shape factor
 LMUX                    = 0.66                  $Scale factor of Fx peak friction coefficient
 LEX                     = 1                     $Scale factor of Fx curvature factor
 LKX                     = 1                   $Scale factor of Fx slip stiffness
 LHX                     = 1                    $Scale factor of Fx horizontal shift
 LVX                     = 1                   $Scale factor of Fx vertical shift
 LCY                     = 1                     $Scale factor of Fy shape factor
 LMUY                    = 0.66                    $Scale factor of Fy peak friction coefficient
 LEY                     = 1                     $Scale factor of Fy curvature factor
 LKY                     = 1                     $Scale factor of Fy cornering stiffness
 LHY                     = 1                    $Scale factor of Fy horizontal shift
 LVY                     = 1                    $Scale factor of Fy vertical shift
 LTR                     = 1                     $Scale factor of peak of pneumatic trail
 LRES                    = 1                     $Scale factor for offset of residual torque
 LXAL                    = 1                     $Scale factor of alpha influence on Fx
 LYKA                    = 1                     $Scale factor of alpha influence on Fx
 LVYKA                   = 1                     $Scale factor of kappa induced Fy
 LS                      = 1                     $Scale factor of moment arm of Fx
 LKYC			 = 1 			$Scale factor of camber force stiffness
 LKZC	  		 = 1 			$Scale factor of camber torque stiffness
 LMUV			 = 1			$scale factor with slip speed decaying friction
 LMX                     = 1                     $Scale factor of overturning couple
 LMY                     = 1                     $Scale factor of rolling resistance torque
$--------------------------------------------------------LONGITUDINAL_FORCE
[LONGITUDINAL_COEFFICIENTS]
 PCX1                    =  2.04008      $Shape factor Cfx for longitudinal force
 PDX1                    =  2.68383      $Longitudinal friction Mux at Fznom
 PDX2                    =  -0.70434      $Variation of friction Mux with load
 PEX1                    =  0.25353      $Longitudinal curvature Efx at Fznom
 PEX2                    =  -0.21909      $Variation of curvature Efx with load
 PEX3                    =  -0.19213      $Variation of curvature Efx with load squared
 PEX4                    =  0.00480      $Factor in curvature Efx while driving
 PKX1                    =  46.79758      $Longitudinal slip stiffness Kfx/Fz at Fznom
 PKX2                    =  -1.54649      $Variation of slip stiffness Kfx/Fz with load
 PKX3                    =  -0.39433      $Exponent in slip stiffness Kfx/Fz with load
 PHX1                    =  0.02735      $Horizontal shift Shx at Fznom
 PHX2                    =  0.02880      $Variation of shift Shx with load
 PVX1                    =  0.10849      $Vertical shift Svx/Fz at Fznom
 PVX2                    =  0.06863      $Variation of shift Svx/Fz with load
 RBX1                    =  9.495624686370633     $Slope factor for combined slip Fx reduction
 RBX2                    =  2.587514427984230      $Variation of slope Fx reduction with kappa
 RCX1                    =  1    $Shape factor for combined slip Fx reduction
 REX1                    =  0    $Curvature factor of combined Fx
 REX2                    =  0     $Curvature factor of combined Fx with load
 RHX1                    =  0.00000      $Shift factor for combined slip Fx reduction
 PTX1                    =  0.00000000E+00      $Relaxation length SigKap0/Fz at Fznom
 PTX2                    =  0.00000000E+00      $Variation of SigKap0/Fz with load
 PTX3                    =  0.00000000E+00      $Variation of SigKap0/Fz with exponent of load
$--------------------------------------------------------OVERTURNING_MOMENT
[OVERTURNING_COEFFICIENTS]
 QSX1                    =  -0.02356847183     $Lateral force induced overturning moment
 QSX2                    =  1.881895309     $Camber induced overturning couple
 QSX3                    =  -0.0730     $Fy induced overturning couple
$-------------------------------------------------------------LATERAL_FORCE
[LATERAL_COEFFICIENTS]
 PCY1                    =  1.46211     $Shape factor Cfy for lateral forces
 PDY1                    =  2.5030     $Lateral friction Muy
 PDY2                    =  -0.1636    $Variation of friction Muy with load
 PDY3                    =  22.21874164   $Variation of friction Muy with squared camber
 PEY1                    =  -0.2203     $Lateral curvature Efy at Fznom
 PEY2                    =  -0.5939     $Variation of curvature Efy with load
 PEY3                    =  -0.7242545867     $Zero order camber dependency of curvature Efy
 PEY4                    =  -10      $Variation of curvature Efy with camber
 PKY1                    =  -35.0700      $Maximum value of stiffness Kfy/Fznom
 PKY2                    =  1.1257     $Load at which Kfy reaches maximum value
 PKY3                    =  1.11294292     $Variation of Kfy/Fznom with camber
 PHY1                    =  0.0006      $Horizontal shift Shy at Fznom
 PHY2                    =  -0.0013     $Variation of shift Shy with load
 PHY3                    =  -0.1279403354      $Variation of shift Shy with camber
 PVY1                    =  0.0258      $Vertical shift in Svy/Fz at Fznom
 PVY2                    =  -0.0383      $Variation of shift Svy/Fz with load
 PVY3                    =  0.3433      $Variation of shift Svy/Fz with camber
 PVY4                    =  1.1157     $Variation of shift Svy/Fz with camber and load
 RBY1                    =  14.053502725031349   $Slope factor for combined Fy reduction
 RBY2                    =  11.853361121515013    $Variation of slope Fy reduction with alpha
 RBY3                    =  0     $Shift term for alpha in slope Fy reduction
 RCY1                    =  0.915223933042185     $Shape factor for combined Fy reduction
 REY1                    =  -0.510172007759721    $Curvature factor of combined Fy
 REY2                    =  0    $Curvature factor of combined Fy with load
 RHY1                    =  0.037532199712685  $Shift factor for combined Fy reduction
 RHY2                    =  0.049026279507185      $Shift factor for combined Fy reduction with load
 RVY1                    =  0.017058420287057     $Kappa induced side force Svyk/Muy*Fz at Fznom
 RVY2                    =  0.044837818976428     $Variation of Svyk/Muy*Fz with load
 RVY3                    =  -0.495514426586620      $Variation of Svyk/Muy*Fz with camber
 RVY4                    =  0.00000      $Variation of Svyk/Muy*Fz with alpha
 RVY5                    =  2.437159166874435      $Variation of Svyk/Muy*Fz with kappa
 RVY6                    =  11.722389011703729     $Variation of Svyk/Muy*Fz with atan(kappa)
 PTY1                    =  0.00000000E+00      $Peak value of relaxation length SigAlp0/R0
 PTY2                    =  0.00000000E+00      $Value of Fz/Fznom where SigAlp0 is extreme
$-------------------------------------------------------------ROLLING_COEFFICIENTS
[ROLLING_COEFFICIENTS]
 QSY1                    =  0.00000      $Rolling resistance torque coefficien
 QSY2                    =  0.00000      $Rolling resistance torque depending on Fx

$-----------------------------------------------------------ALIGNING_TORQUE
[ALIGNING_COEFFICIENTS]
 QBZ1                    =  11.8725      $Trail slope factor for trail Bpt at Fznom
 QBZ2                    =  -7.1262      $Variation of slope Bpt with load
 QBZ3                    =  5.6016      $Variation of slope Bpt with load squared
 QBZ4                    =  20.3448      $Variation of slope Bpt with camber
 QBZ5                    =  -19.4732     $Variation of slope Bpt with absolute camber
 QBZ9                    =  2.6696     $Slope factor Br of residual torque Mzr
 QBZ10                   =  0.3854     $Slope factor Br of residual torque Mzr
 QCZ1                    =  1.1986      $Shape factor Cpt for pneumatic trail
 QDZ1                    =  0.2145     $Peak trail Dpt" = Dpt*(Fz/Fznom*R0)
 QDZ2                    =  -0.0357     $Variation of peak Dpt" with load
 QDZ3                    =  12.2953      $Variation of peak Dpt" with camber
 QDZ4                    =  -319.3970     $Variation of peak Dpt" with camber squared
 QDZ6                    =  -0.0066      $Peak residual torque Dmr" = Dmr/(Fz*R0)
 QDZ7                    =  0.0014    $Variation of peak factor Dmr" with load
 QDZ8                    =  4.6109      $Variation of peak factor Dmr" with camber
 QDZ9                    =  -3.1725    $Variation of peak factor Dmr" with camber and load
 QEZ1                    =  -0.4622    $Trail curvature Ept at Fznom
 QEZ2                    =  -0.6041    $Variation of curvature Ept with load
 QEZ3                    =  1.2332     $Variation of curvature Ept with load squared
 QEZ4                    =  -0.0275     $Variation of curvature Ept with sign of Alpha-t
 QEZ5                    =  40.0000            $Variation of Ept with camber and sign Alpha-t
 QHZ1                    =  0.0035     $Trail horizontal shift Sht at Fznom
 QHZ2                    =  0.0042    $Variation of shift Sht with load
 QHZ3                    =  0.5250     $Variation of shift Sht with camber
 QHZ4                    =  -0.6094     $Variation of shift Sht with camber and load
 SSZ1                    =  0.00000              $Nominal value of s/R0: effect of Fx on Mz         
 SSZ2                    =  0.00000              $Variation of distance s/R0 with Fy/Fznom         
 SSZ3                    =  0.00000              $Variation of distance s/R0 with camber         
 SSZ4                    =  0.00000              $Variation of distance s/R0 with load and camber         
 QTZ1                    =  0                    $Gyration torque constant         
 MBELT                   =  0                    $Belt mass of the wheel         
   
