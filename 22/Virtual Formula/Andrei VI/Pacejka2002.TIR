[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             = 3.0
FILE_FORMAT              ='ASCII'
$----------------------------------------------------------------units
[UNITS]
LENGTH              = 'meter'
FORCE               = 'newton'
ANGLE               = 'radians'
MASS                = 'kg'
TIME                = 'second'
$----------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT     ='PAC2002'
USE_MODE                 = 4                    $Tyre use switch (IUSED)
VXLOW                    = 1            
LONGVL                   = 11.20000          $Measurement speed 
TYRESIDE                 = 'RIGHT'              $Mounted side of tyre at vehicle/test bench
$-----------------------------------------------------------dimensions
[DIMENSION]
UNLOADED_RADIUS          = 0.26035               $Free tyre radius 
WIDTH                    = 0.2               $Nominal section width of the tyre 
ASPECT_RATIO             = 0.2               $Nominal aspect ratio
RIM_RADIUS               = 0.2               $Nominal rim radius 
RIM_WIDTH                = 0.255               $Rim width 
$----------------------------------------------------------------shape
[SHAPE]
{radial width}
 1.0    0.0 
 1.0    0.4 
 1.0    0.9 
 0.9    1.0 
$------------------------------------------------------------parameter
[VERTICAL]
VERTICAL_STIFFNESS       = 200000            $Tyre vertical stiffness 
VERTICAL_DAMPING         = 500                  $Tyre vertical damping       
BREFF                    = 3.5                  $Low load stiffness e.r.r.     
DREFF                    = 0.5                  $Peak value of e.r.r.     
FREFF                    = 0.005               $High load stiffness e.r.r.     
FNOMIN                   = 731.40000              $Nominal wheel load
$------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -0.53              $Minimum valid wheel slip
KPUMAX                   = 0.35              $Maximum valid wheel slip
$-----------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -0.35              $Minimum valid slip angle
ALPMAX                   = 0.35              $Maximum valid slip angle
$-----------------------------------------------inclination_slip_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.09              $Minimum valid camber angle
CAMMAX                   = 0.09              $Maximum valid camber angle
$-------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 0                $Minimum allowed wheel load
FZMAX                    = 10000               $Maximum allowed wheel load
$--------------------------------------------------------------scaling
[SCALING_COEFFICIENTS]
 LFZ0                    = 1.00000                    $Scale factor of nominal (rated) load
 LCX                     = 1.00000                    $Scale factor of Fx shape factor
 LMUX                    = 1.00000                    $Scale factor of Fx peak friction coefficient
 LEX                     = 1.00000                    $Scale factor of Fx curvature factor
 LKX                     = 1.00000                    $Scale factor of Fx slip stiffness
 LHX                     = 1.00000                    $Scale factor of Fx horizontal shift
 LVX                     = 1.00000                    $Scale factor of Fx vertical shift
 LCY                     = 1.00000                    $Scale factor of Fy shape factor
 LMUY                    = 1.00000                    $Scale factor of Fy peak friction coefficient
 LEY                     = 1.00000                    $Scale factor of Fy curvature factor
 LKY                     = 1.00000                    $Scale factor of Fy cornering stiffness
 LHY                     = 1.00000                    $Scale factor of Fy horizontal shift
 LVY                     = 1.00000                    $Scale factor of Fy vertical shift
 LTR                     = 1.00000                    $Scale factor of peak of pneumatic trail
 LRES                    = 1.00000                    $Scale factor for offset of residual torque
 LXAL                    = 1.00000                    $Scale factor of alpha influence on Fx
 LYKA                    = 1.00000                    $Scale factor of alpha influence on Fx
 LVYKA                   = 1.00000                    $Scale factor of kappa induced Fy
 LS                      = 1.00000                    $Scale factor of moment arm of Fx
 LKYC			 = 1.00000			$Scale factor of camber force stiffness
 LKZC	  		 = 1.00000			$Scale factor of camber torque stiffness
 LMUV			 = 0.00000			$scale factor with slip speed decaying friction
 LMX                     = 1.00000                    $Scale factor of overturning couple
 LMY                     = 1.00000                    $Scale factor of rolling resistance torque
$--------------------------------------------------------LONGITUDINAL_FORCE
[LONGITUDINAL_COEFFICIENTS]
 PCX1                    =  0.76263      $Shape factor Cfx for longitudinal force
 PDX1                    =  2.92060      $Longitudinal friction Mux at Fznom
 PDX2                    =  -0.16135      $Variation of friction Mux with load
 PEX1                    =  -6.48045      $Longitudinal curvature Efx at Fznom
 PEX2                    =  -0.04203      $Variation of curvature Efx with load
 PEX3                    =  -0.10453      $Variation of curvature Efx with load squared
 PEX4                    =  -0.03051      $Factor in curvature Efx while driving
 PKX1                    =  -42.84337      $Longitudinal slip stiffness Kfx/Fz at Fznom
 PKX2                    =  -31.42072      $Variation of slip stiffness Kfx/Fz with load
 PKX3                    =  -0.96548      $Exponent in slip stiffness Kfx/Fz with load
 PHX1                    =  0.02034      $Horizontal shift Shx at Fznom
 PHX2                    =  0.02189      $Variation of shift Shx with load
 PVX1                    =  0.09263      $Vertical shift Svx/Fz at Fznom
 PVX2                    =  -0.03687      $Variation of shift Svx/Fz with load
 RBX1                    =  6.38748      $Slope factor for combined slip Fx reduction
 RBX2                    =  6.22924      $Variation of slope Fx reduction with kappa
 RCX1                    =  1.66382      $Shape factor for combined slip Fx reduction
 REX1                    =  0.00293      $Curvature factor of combined Fx
 REX2                    =  -0.21950      $Curvature factor of combined Fx with load
 RHX1                    =  0.01498      $Shift factor for combined slip Fx reduction
 PTX1                    =  0.00000000E+00      $Relaxation length SigKap0/Fz at Fznom
 PTX2                    =  0.00000000E+00      $Variation of SigKap0/Fz with load
 PTX3                    =  0.00000000E+00      $Variation of SigKap0/Fz with exponent of load
$--------------------------------------------------------OVERTURNING_MOMENT
[OVERTURNING_COEFFICIENTS]
 QSX1                    =  0.00000      $Lateral force induced overturning moment
 QSX2                    =  0.00000      $Camber induced overturning couple
 QSX3                    =  0.00000      $Fy induced overturning couple
$-------------------------------------------------------------LATERAL_FORCE
[LATERAL_COEFFICIENTS]
 PCY1                    =  0.54633      $Shape factor Cfy for lateral forces
 PDY1                    =  -3.95115      $Lateral friction Muy
 PDY2                    =  0.26549      $Variation of friction Muy with load
 PDY3                    =  13.92153      $Variation of friction Muy with squared camber
 PEY1                    =  -2.14047      $Lateral curvature Efy at Fznom
 PEY2                    =  1.18836      $Variation of curvature Efy with load
 PEY3                    =  -0.20017      $Zero order camber dependency of curvature Efy
 PEY4                    =  -0.50875      $Variation of curvature Efy with camber
 PKY1                    =  76.25967      $Maximum value of stiffness Kfy/Fznom
 PKY2                    =  2.71015      $Load at which Kfy reaches maximum value
 PKY3                    =  17.39495      $Variation of Kfy/Fznom with camber
 PHY1                    =  0.00142      $Horizontal shift Shy at Fznom
 PHY2                    =  -0.00234      $Variation of shift Shy with load
 PHY3                    =  -0.16334      $Variation of shift Shy with camber
 PVY1                    =  -0.03083      $Vertical shift in Svy/Fz at Fznom
 PVY2                    =  0.04426      $Variation of shift Svy/Fz with load
 PVY3                    =  2.11056      $Variation of shift Svy/Fz with camber
 PVY4                    =  -0.91647      $Variation of shift Svy/Fz with camber and load
 RBY1                    =  0.00000      $Slope factor for combined Fy reduction
 RBY2                    =  0.00000      $Variation of slope Fy reduction with alpha
 RBY3                    =  0.00000      $Shift term for alpha in slope Fy reduction
 RCY1                    =  0.00000      $Shape factor for combined Fy reduction
 REY1                    =  0.00000      $Curvature factor of combined Fy
 REY2                    =  0.00000      $Curvature factor of combined Fy with load
 RHY1                    =  0.00000      $Shift factor for combined Fy reduction
 RHY2                    =  0.00000      $Shift factor for combined Fy reduction with load
 RVY1                    =  0.00000      $Kappa induced side force Svyk/Muy*Fz at Fznom
 RVY2                    =  0.00000      $Variation of Svyk/Muy*Fz with load
 RVY3                    =  0.00000      $Variation of Svyk/Muy*Fz with camber
 RVY4                    =  0.00000      $Variation of Svyk/Muy*Fz with alpha
 RVY5                    =  0.00000      $Variation of Svyk/Muy*Fz with kappa
 RVY6                    =  0.00000      $Variation of Svyk/Muy*Fz with atan(kappa)
 PTY1                    =  0.00000000E+00      $Peak value of relaxation length SigAlp0/R0
 PTY2                    =  0.00000000E+00      $Value of Fz/Fznom where SigAlp0 is extreme
$-------------------------------------------------------------ROLLING_COEFFICIENTS
[ROLLING_COEFFICIENTS]
 QSY1                    =  0.00000      $Rolling resistance torque coefficien
 QSY2                    =  0.00000      $Rolling resistance torque depending on Fx

$-----------------------------------------------------------ALIGNING_TORQUE
[ALIGNING_COEFFICIENTS]
 QBZ1                    =  1.49016      $Trail slope factor for trail Bpt at Fznom
 QBZ2                    =  0.43729      $Variation of slope Bpt with load
 QBZ3                    =  -0.29336      $Variation of slope Bpt with load squared
 QBZ5                    =  0.53442      $Variation of slope Bpt with absolute camber
 QBZ6			 =  0.00000
 QBZ9                    =  51.44935      $Slope factor Br of residual torque Mzr
 QBZ10                   =  3.13151      $Slope factor Br of residual torque Mzr
 QCZ1                    =  1.00948      $Shape factor Cpt for pneumatic trail
 QDZ1                    =  0.08423      $Peak trail Dpt" = Dpt*(Fz/Fznom*R0)
 QDZ2                    =  -0.01077      $Variation of peak Dpt" with load
 QDZ3                    =  1.45012      $Variation of peak Dpt" with camber
 QDZ4                    =  -13.26757      $Variation of peak Dpt" with camber squared
 QDZ6                    =  -0.01183      $Peak residual torque Dmr" = Dmr/(Fz*R0)
 QDZ7                    =  0.00642      $Variation of peak factor Dmr" with load
 QDZ8                    =  -1.83183      $Variation of peak factor Dmr" with camber
 QDZ9                    =  -0.32526      $Variation of peak factor Dmr" with camber and load
 QEZ1                    =  -931.06940      $Trail curvature Ept at Fznom
 QEZ2                    =  882.89790      $Variation of curvature Ept with load
 QEZ3                    =  -385.51100      $Variation of curvature Ept with load squared
 QEZ4                    =  0.88438      $Variation of curvature Ept with sign of Alpha-t
 QEZ5                    =  -24.46260      $Variation of Ept with camber and sign Alpha-t
 QHZ1                    =  -0.00713      $Trail horizontal shift Sht at Fznom
 QHZ2                    =  0.00090      $Variation of shift Sht with load
 QHZ3                    =  0.45370      $Variation of shift Sht with camber
 QHZ4                    =  0.04842      $Variation of shift Sht with camber and load
 SSZ1                    =  0.00000              $Nominal value of s/R0: effect of Fx on Mz         
 SSZ2                    =  0.00000              $Variation of distance s/R0 with Fy/Fznom         
 SSZ3                    =  0.00000              $Variation of distance s/R0 with camber         
 SSZ4                    =  0.00000              $Variation of distance s/R0 with load and camber         
 QTZ1                    =  0                    $Gyration torque constant         
 MBELT                   =  0                    $Belt mass of the wheel         
