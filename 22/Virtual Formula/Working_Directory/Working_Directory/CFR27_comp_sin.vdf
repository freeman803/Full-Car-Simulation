SPEED_MAP_ABS_TIME = 'FALSE'
SPEED_MAP_GLOBAL_S = 'FALSE'
CONNECT_PATH = 'FALSE'
(END_CONDITIONS)
{ name   }
 'MANEUVER_1_END_COND_BLOCK'
