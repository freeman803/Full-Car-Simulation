$------------------------------------------------------------MANEUVER_1_THROTTLE
[MANEUVER_1_THROTTLE]
METHOD = 'MACHINE'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0
$-------------------------------------------------------------MANEUVER_1_BRAKING
[MANEUVER_1_BRAKING]
METHOD = 'OPENLOOP'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0
SIGNAL = 'MAINTAIN_SIGNAL'
$----------------------------------------------------------------MANEUVER_1_GEAR
[MANEUVER_1_GEAR]
METHOD = 'OPENLOOP'
SMOOTHING_ACTIVE = 'FALSE'
SMOOTHING_TIME = 0
SIGNAL = 'MAINTAIN_SIGNAL'
$--------------------------------------------------------------MANEUVER_1_CLUTCH
[MANEUVER_1_CLUTCH]
METHOD = 'OPENLOOP'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0
SIGNAL = 'MAINTAIN_SIGNAL'
$------------------------------------------------------------MANEUVER_1_BRAKING2
[MANEUVER_1_BRAKING2]
METHOD = 'USER'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0.1
$---------------------------------------------------------------------MANEUVER_1
[MANEUVER_1]
TASK = 'STANDARD'
CONTROLLER_SETTINGS = 'CONTROLLER_STANDARD'
(STEERING)
CONTROLLER_NAME = 'MANEUVER_1_STEERING'
(THROTTLE)
