[MDI_HEADER]
FILE_TYPE                ='tir'
FILE_VERSION             = 3.0
FILE_FORMAT              ='ASCII'
$----------------------------------------------------------------units
[UNITS]
LENGTH              = 'meter'
FORCE               = 'newton'
ANGLE               = 'radians'
MASS                = 'kg'
TIME                = 'second'
$----------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT     ='PAC2002'
USE_MODE                 = 4                    $Tyre use switch (IUSED)
VXLOW                    = 1            
LONGVL                   = 11.17600          $Measurement speed 
TYRESIDE                 = 'RIGHT'              $Mounted side of tyre at vehicle/test bench
$-----------------------------------------------------------dimensions
[DIMENSION]
UNLOADED_RADIUS          = 0.26035               $Free tyre radius 
WIDTH                    = 0.2               $Nominal section width of the tyre 
ASPECT_RATIO             = 0.2               $Nominal aspect ratio
RIM_RADIUS               = 0.2               $Nominal rim radius 
RIM_WIDTH                = 0.255               $Rim width 
$----------------------------------------------------------------shape
[SHAPE]
{radial width}
 1.0    0.0 
 1.0    0.4 
 1.0    0.9 
 0.9    1.0 
$------------------------------------------------------------parameter
[VERTICAL]
VERTICAL_STIFFNESS       = 200000            $Tyre vertical stiffness 
VERTICAL_DAMPING         = 500                  $Tyre vertical damping       
BREFF                    = 3.5                  $Low load stiffness e.r.r.     
DREFF                    = 0.5                  $Peak value of e.r.r.     
FREFF                    = -0.005               $High load stiffness e.r.r.     
FNOMIN                   = 889.64430              $Nominal wheel load
$------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -0.53              $Minimum valid wheel slip
KPUMAX                   = 0.35              $Maximum valid wheel slip
$-----------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -0.35              $Minimum valid slip angle
ALPMAX                   = 0.35              $Maximum valid slip angle
$-----------------------------------------------inclination_slip_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.09              $Minimum valid camber angle
CAMMAX                   = 0.09              $Maximum valid camber angle
$-------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 0                $Minimum allowed wheel load
FZMAX                    = 10000               $Maximum allowed wheel load
$--------------------------------------------------------------scaling
[SCALING_COEFFICIENTS]
 LFZ0                    = 1                     $Scale factor of nominal (rated) load
 LCX                     = 1                     $Scale factor of Fx shape factor
 LMUX                    = 0.66000                    $Scale factor of Fx peak friction coefficient
 LEX                     = 1                     $Scale factor of Fx curvature factor
 LKX                     = 1                   $Scale factor of Fx slip stiffness
 LHX                     = 1                    $Scale factor of Fx horizontal shift
 LVX                     = 1                   $Scale factor of Fx vertical shift
 LCY                     = 1                     $Scale factor of Fy shape factor
 LMUY                    = 0.66000                     $Scale factor of Fy peak friction coefficient
 LEY                     = 1                     $Scale factor of Fy curvature factor
 LKY                     = 1                     $Scale factor of Fy cornering stiffness
 LHY                     = 1                    $Scale factor of Fy horizontal shift
 LVY                     = 1                    $Scale factor of Fy vertical shift
 LTR                     = 1                     $Scale factor of peak of pneumatic trail
 LRES                    = 1                     $Scale factor for offset of residual torque
 LXAL                    = 1                     $Scale factor of alpha influence on Fx
 LYKA                    = 1                     $Scale factor of alpha influence on Fx
 LVYKA                   = 1                     $Scale factor of kappa induced Fy
 LS                      = 1                     $Scale factor of moment arm of Fx
 LKYC			 = 1 			$Scale factor of camber force stiffness
 LKZC	  		 = 1 			$Scale factor of camber torque stiffness
 LMUV			 = 1			$scale factor with slip speed decaying friction
 LMX                     = 1                     $Scale factor of overturning couple
 LMY                     = 1                     $Scale factor of rolling resistance torque
$--------------------------------------------------------LONGITUDINAL_FORCE
[LONGITUDINAL_COEFFICIENTS]
 PCX1                    =  2.04008      $Shape factor Cfx for longitudinal force
 PDX1                    =  2.68383      $Longitudinal friction Mux at Fznom
 PDX2                    =  -0.70434      $Variation of friction Mux with load
 PEX1                    =  0.25353      $Longitudinal curvature Efx at Fznom
 PEX2                    =  -0.21909      $Variation of curvature Efx with load
 PEX3                    =  -0.19213      $Variation of curvature Efx with load squared
 PEX4                    =  0.00480      $Factor in curvature Efx while driving
 PKX1                    =  46.79758      $Longitudinal slip stiffness Kfx/Fz at Fznom
 PKX2                    =  -1.54649      $Variation of slip stiffness Kfx/Fz with load
 PKX3                    =  -0.39433      $Exponent in slip stiffness Kfx/Fz with load
 PHX1                    =  0.02735      $Horizontal shift Shx at Fznom
 PHX2                    =  0.02880      $Variation of shift Shx with load
 PVX1                    =  0.10849      $Vertical shift Svx/Fz at Fznom
 PVX2                    =  0.06863      $Variation of shift Svx/Fz with load
 RBX1                    =  -27.74554      $Slope factor for combined slip Fx reduction
 RBX2                    =  -12.79781      $Variation of slope Fx reduction with kappa
 RCX1                    =  0.83575      $Shape factor for combined slip Fx reduction
 REX1                    =  0.20794      $Curvature factor of combined Fx
 REX2                    =  0.95408      $Curvature factor of combined Fx with load
 RHX1                    =  0.00000      $Shift factor for combined slip Fx reduction
 PTX1                    =  0.00000000E+00      $Relaxation length SigKap0/Fz at Fznom
 PTX2                    =  0.00000000E+00      $Variation of SigKap0/Fz with load
 PTX3                    =  0.00000000E+00      $Variation of SigKap0/Fz with exponent of load
$--------------------------------------------------------OVERTURNING_MOMENT
[OVERTURNING_COEFFICIENTS]
 QSX1                    =  0.00000      $Lateral force induced overturning moment
 QSX2                    =  0.00000      $Camber induced overturning couple
 QSX3                    =  0.00000      $Fy induced overturning couple
$-------------------------------------------------------------LATERAL_FORCE
[LATERAL_COEFFICIENTS]
 PCY1                    =  1.52911      $Shape factor Cfy for lateral forces
 PDY1                    =  2.51974      $Lateral friction Muy
 PDY2                    =  -0.12910      $Variation of friction Muy with load
 PDY3                    =  6.09183      $Variation of friction Muy with squared camber
 PEY1                    =  -0.19011      $Lateral curvature Efy at Fznom
 PEY2                    =  0.42709      $Variation of curvature Efy with load
 PEY3                    =  0.06226      $Zero order camber dependency of curvature Efy
 PEY4                    =  40.88990      $Variation of curvature Efy with camber
 PKY1                    =  -35.78977      $Maximum value of stiffness Kfy/Fznom
 PKY2                    =  1.13328      $Load at which Kfy reaches maximum value
 PKY3                    =  4.46418      $Variation of Kfy/Fznom with camber
 PHY1                    =  0.00011      $Horizontal shift Shy at Fznom
 PHY2                    =  0.00397      $Variation of shift Shy with load
 PHY3                    =  0.10357      $Variation of shift Shy with camber
 PVY1                    =  0.01278      $Vertical shift in Svy/Fz at Fznom
 PVY2                    =  0.11858      $Variation of shift Svy/Fz with load
 PVY3                    =  1.17295      $Variation of shift Svy/Fz with camber
 PVY4                    =  -1.58815      $Variation of shift Svy/Fz with camber and load
 RBY1                    =  0.00000      $Slope factor for combined Fy reduction
 RBY2                    =  0.00000      $Variation of slope Fy reduction with alpha
 RBY3                    =  0.00000      $Shift term for alpha in slope Fy reduction
 RCY1                    =  0.00000      $Shape factor for combined Fy reduction
 REY1                    =  0.00000      $Curvature factor of combined Fy
 REY2                    =  0.00000      $Curvature factor of combined Fy with load
 RHY1                    =  0.00000      $Shift factor for combined Fy reduction
 RHY2                    =  0.00000      $Shift factor for combined Fy reduction with load
 RVY1                    =  0.00000      $Kappa induced side force Svyk/Muy*Fz at Fznom
 RVY2                    =  0.00000      $Variation of Svyk/Muy*Fz with load
 RVY3                    =  0.00000      $Variation of Svyk/Muy*Fz with camber
 RVY4                    =  0.00000      $Variation of Svyk/Muy*Fz with alpha
 RVY5                    =  0.00000      $Variation of Svyk/Muy*Fz with kappa
 RVY6                    =  0.00000      $Variation of Svyk/Muy*Fz with atan(kappa)
 PTY1                    =  0.00000000E+00      $Peak value of relaxation length SigAlp0/R0
 PTY2                    =  0.00000000E+00      $Value of Fz/Fznom where SigAlp0 is extreme
$-------------------------------------------------------------ROLLING_COEFFICIENTS
[ROLLING_COEFFICIENTS]
 QSY1                    =  0.00000      $Rolling resistance torque coefficien
 QSY2                    =  0.00000      $Rolling resistance torque depending on Fx

$-----------------------------------------------------------ALIGNING_TORQUE
[ALIGNING_COEFFICIENTS]
 QBZ1                    =  -3.94473      $Trail slope factor for trail Bpt at Fznom
 QBZ2                    =  2.33705      $Variation of slope Bpt with load
 QBZ3                    =  -1.36460      $Variation of slope Bpt with load squared
 QBZ5                    =  1.35503      $Variation of slope Bpt with absolute camber
 QBZ6			 =  0.00000
 QBZ9                    =  -18.63228      $Slope factor Br of residual torque Mzr
 QBZ10                   =  -0.72429      $Slope factor Br of residual torque Mzr
 QCZ1                    =  0.99988      $Shape factor Cpt for pneumatic trail
 QDZ1                    =  0.17623      $Peak trail Dpt" = Dpt*(Fz/Fznom*R0)
 QDZ2                    =  -0.00456      $Variation of peak Dpt" with load
 QDZ3                    =  1.80581      $Variation of peak Dpt" with camber
 QDZ4                    =  19.88838      $Variation of peak Dpt" with camber squared
 QDZ6                    =  -0.00831      $Peak residual torque Dmr" = Dmr/(Fz*R0)
 QDZ7                    =  0.01375      $Variation of peak factor Dmr" with load
 QDZ8                    =  -4.39952      $Variation of peak factor Dmr" with camber
 QDZ9                    =  -2.71182      $Variation of peak factor Dmr" with camber and load
 QEZ1                    =  -68.17952      $Trail curvature Ept at Fznom
 QEZ2                    =  -264.50950      $Variation of curvature Ept with load
 QEZ3                    =  -442.92210      $Variation of curvature Ept with load squared
 QEZ4                    =  -0.24412      $Variation of curvature Ept with sign of Alpha-t
 QEZ5                    =  7.60920      $Variation of Ept with camber and sign Alpha-t
 QHZ1                    =  -0.00221      $Trail horizontal shift Sht at Fznom
 QHZ2                    =  0.00475      $Variation of shift Sht with load
 QHZ3                    =  -0.38519      $Variation of shift Sht with camber
 QHZ4                    =  0.16470      $Variation of shift Sht with camber and load
 SSZ1                    =  0.00000              $Nominal value of s/R0: effect of Fx on Mz         
 SSZ2                    =  0.00000              $Variation of distance s/R0 with Fy/Fznom         
 SSZ3                    =  0.00000              $Variation of distance s/R0 with camber         
 SSZ4                    =  0.00000              $Variation of distance s/R0 with load and camber         
 QTZ1                    =  0                    $Gyration torque constant         
 MBELT                   =  0                    $Belt mass of the wheel         
   
