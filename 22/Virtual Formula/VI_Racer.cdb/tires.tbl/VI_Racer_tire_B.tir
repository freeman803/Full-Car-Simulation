$--------------------------------------------------------------------MDI_HEADER
[MDI_HEADER]
FILE_TYPE                = 'tir'                
FILE_VERSION             = 3.0                  
FILE_FORMAT              = 'ASCII'              
$--------------------------------------------------------------------------units
[UNITS]
LENGTH                   = 'meter'              
FORCE                    = 'newton'             
ANGLE                    = 'radians'            
MASS                     = 'kg'                 
TIME                     = 'second'             
$--------------------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT     = 'PAC2002'            
USE_MODE                 = 14                   $Tyre use switch (IUSED)
VXLOW                    = 3.0                  $Threshold speed for scaling down forces and moments
LONGVL                   = 16.6                 $Measurement speed
TYRESIDE                 = 'LEFT'               $Mounted side of tyre at vehicle/test bench
$----------------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS          = 0.26035                $Free tyre radius
WIDTH                    = 0.1778                $Nominal section width of the tyre
ASPECT_RATIO             = 0.65                 $Nominal aspect ratio
RIM_RADIUS               = 0.1651               $Nominal rim radius
RIM_WIDTH                = 0.1778               $Rim width
$--------------------------------------------------------------------------shape
[SHAPE]
{RADIAL_SHAPE            WIDTH_SHAPE}
 1.000000                      0.000000
 1.000000                      0.400000
 1.000000                      0.900000
 0.900000                      1.000000
$----------------------------------------------------------------tire_conditions
$----------------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -1.0                 $Minimum valid wheel slip
KPUMAX                   = 1.0                  $Maximum valid wheel slip
$---------------------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -1.5708              $Minimum valid slip angle
ALPMAX                   = 1.5708               $Maximum valid slip angle
$--------------------------------------------------------inclination_angle_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.523598775598      $Minimum valid camber angle
CAMMAX                   = 0.523598775598       $Maximum valid camber angle
$---------------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 4.0                  $Minimum allowed wheel load
FZMAX                    = 9900.0               $Maximum allowed wheel load
$-------------------------------------------------------------------------------vertical
[VERTICAL]                              
VERTICAL_STIFFNESS       = 200000.0             $Tyre vertical stiffness
VERTICAL_DAMPING         = 150.0                 $Tyre vertical damping
BREFF                    = 6.1                  $Low load stiffness effective rolling radius
DREFF                    = 0.45                 $Peak value of effective rolling radius
FREFF                    = 0.01                 $High load stiffness effective rolling radius
FNOMIN                   = 700.0               $Nominal wheel load
$-------------------------------------------------------------------scaling_coefficients                                                           
[SCALING_COEFFICIENTS]                                                                                                                             
LFZO                     = 1.0                  $Scale factor of nominal (rated) load
LCX	=	0.68	$Scale factor of Fx shape factor
LMUX	=	1.41	$Scale factor of Fx peak friction coefficient
LEX	=	1.13	$Scale factor of Fx curvature factor
LKX	=	3.15	$Scale factor of Fx slip stiffness
LHX	=	1.09	$Scale factor of Fx horizontal shift
LVX	=	0.98	$Scale factor of Fx vertical shift
LGAX	=	0.98	$Scale factor of camber for Fx
LCY	=	0.73	$Scale factor of Fy shape factor 1.0
LMUY	=	1.24	$Scale factor of Fy peak friction coefficient
LEY	=	0.91	$Scale factor of Fy curvature factor 1.0
LKY	=	4.31	$Scale factor of Fy cornering stiffness
LHY	=	1.08	$Scale factor of Fy horizontal shift
LVY	=	0.92	$Scale factor of Fy vertical shift
LGAY	=	1.08	$Scale factor of camber for Fy
LTR	=	1.06	$Scale factor of Peak of pneumatic trail
LRES	=	0.00	$Scale factor for offset of residual torque
LGAZ	=	1.04	$Scale factor of camber for Mz
LXAL	=	0.90	$Scale factor of alpha influence on Fx
LYKA	=	0.99	$Scale factor of kappa influence on Fy
LVYKA	=	1.05	$Scale factor of kappa induced Fy
LS	=	0.98	$Scale factor of Moment arm of Fx
LSGKP	=	0.96	$Scale factor of Relaxation length of Fx
LSGAL	=	0.95	$Scale factor of Relaxation length of Fy
LGYR	=	1.10	$Scale factor of gyroscopic torque
LMX	=	1.08	$Scale factor of overturning couple
LVMX	=	0.94	$Scale factor of Mx vertical shift
LMY	=	0.95	$Scale factor of rolling resistance torque
LIP	=	1.04	$Scale factor of inflation pressure
LCZ	=	1.04	$Scale factor of vertical tire stiffness
LKYG	=	0.97	$Scale factor of camber stiffness
$--------------------------------------------------------------longitudinal_coefficients                                                                    
[LONGITUDINAL_COEFFICIENTS]                                                                                                                        
PCX1                     = 1.839                $Shape factor Cfx for longitudinal force
PDX1                     = 1.1387               $Longitudinal friction Mux at Fznom
PDX2                     = -0.11999             $Variation of friction Mux with load
PDX3                     = 12.2142		        $Variation of friction Mux with camber -2.2142e-005
PEX1                     = 0.62727              $Longitudinal curvature Efx at Fznom
PEX2                     = -0.02336             $Variation of curvature Efx with load -0.12336
PEX3                     = -0.003448             $Variation of curvature Efx with load squared -0.03448
PEX4                     = -1.5066e-005         $Factor in curvature Efx while driving
PKX1                     = 18.886               $Longitudinal slip stiffness Kfx/Fz at Fznom
PKX2                     = -3.988               $Variation of slip stiffness Kfx/Fz with load
PKX3                     = 0.21542              $Exponent in slip stiffness Kfx/Fz with load
PHX1                     = -0.00033912          $Horizontal shift Shx at Fznom
PHX2                     = -8.5877e-006         $Variation of shift Shx with load
PVX1                     = -4.638e-006          $Vertical shift Svx/Fz at Fznom
PVX2                     = 1.9874e-005          $Variation of shift Svx/Fz with load
PPX1                     = 0.0                  
PPX2                     = 0.0                  
PPX3                     = 0.0                  
PPX4                     = 0.0                  
RBX1                     = 5.9945               $Slope factor for combined slip Fx reduction
RBX2                     = -8.2609              $Variation of slope Fx reduction with kappa
RCX1                     = 1.07816              $Shape factor for combined slip Fx reduction
REX1                     = 1.644                $Curvature factor of combined Fx
REX2                     = -0.0064359           $Curvature factor of combined Fx with load
RHX1                     = 0.008847             $Shift factor for combined slip Fx reduction
PTX1                     = 0.8                  $Relaxation length SigKap0/Fz at Fznom
PTX2                     = 0.000109             $Variation of SigKap0/Fz with load
PTX3                     = 0.101                $Variation of SigKap0/Fz with exponent of load
PTX4                     = 0.0                  
$---------------------------------------------------------------overturning_coefficients                                                                    
[OVERTURNING_COEFFICIENTS]                                                                                                                                  
QSX1                     = 0.0                  $Lateral force induced overturning moment
QSX2                     = 0.0                  $Camber induced overturning couple
QSX3                     = 0.0                  $Fy induced overturning couple
QSX4                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection
QSX5                     = 0.1                  $Fz induced overturning couple due to lateral tire deflection
QSX6                     = 0.1                  $Fz induced overturning couple due to lateral tire deflection
QSX7                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by inclination
QSX8                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by lateral force
QSX9                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by lateral force
QSX10                    = 0.0                  $Inclination induced overturning couple, load dependency
QSX11                    = 0.0                  $load dependency inclination induced overturning couple
QPX1                     = 0.0                  $Variation of camber effect with pressure
