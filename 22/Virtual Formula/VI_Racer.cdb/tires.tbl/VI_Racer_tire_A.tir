$--------------------------------------------------------------------MDI_HEADER
[MDI_HEADER]
FILE_TYPE                = 'tir'                
FILE_VERSION             = 3.0                  
FILE_FORMAT              = 'ASCII'              
$--------------------------------------------------------------------------units
[UNITS]
LENGTH                   = 'meter'              
FORCE                    = 'newton'             
ANGLE                    = 'radians'            
MASS                     = 'kg'                 
TIME                     = 'second'             
$--------------------------------------------------------------------------model
[MODEL]
PROPERTY_FILE_FORMAT     = 'PAC2002'            
USE_MODE                 = 14                   $Tyre use switch (IUSED)
VXLOW                    = 3.0                  $Threshold speed for scaling down forces and moments
LONGVL                   = 16.6                 $Measurement speed
TYRESIDE                 = 'LEFT'               $Mounted side of tyre at vehicle/test bench
$----------------------------------------------------------------------dimension
[DIMENSION]
UNLOADED_RADIUS          = 0.26035                $Free tyre radius
WIDTH                    = 0.1778                $Nominal section width of the tyre
ASPECT_RATIO             = 0.65                 $Nominal aspect ratio
RIM_RADIUS               = 0.1651               $Nominal rim radius
RIM_WIDTH                = 0.2032               $Rim width
$--------------------------------------------------------------------------shape
[SHAPE]
{RADIAL_SHAPE            WIDTH_SHAPE}
 1.000000                      0.000000
 1.000000                      0.400000
 1.000000                      0.900000
 0.900000                      1.000000
$----------------------------------------------------------------tire_conditions
$----------------------------------------------------------------long_slip_range
[LONG_SLIP_RANGE]
KPUMIN                   = -.53                 $Minimum valid wheel slip
KPUMAX                   = .35                  $Maximum valid wheel slip
$---------------------------------------------------------------slip_angle_range
[SLIP_ANGLE_RANGE]
ALPMIN                   = -.35              $Minimum valid slip angle
ALPMAX                   = .35               $Maximum valid slip angle
$--------------------------------------------------------inclination_angle_range
[INCLINATION_ANGLE_RANGE]
CAMMIN                   = -0.09      $Minimum valid camber angle
CAMMAX                   = 0.09       $Maximum valid camber angle
$---------------------------------------------------------vertical_force_range
[VERTICAL_FORCE_RANGE]
FZMIN                    = 0                  $Minimum allowed wheel load
FZMAX                    = 10000.0               $Maximum allowed wheel load
$-------------------------------------------------------------------------------vertical
[VERTICAL]                              
VERTICAL_STIFFNESS       = 200000.0             $Tyre vertical stiffness
VERTICAL_DAMPING         = 500.0                 $Tyre vertical damping
BREFF                    = 3.5                  $Low load stiffness effective rolling radius
DREFF                    = 0.5                 $Peak value of effective rolling radius
FREFF                    = -.005                 $High load stiffness effective rolling radius
FNOMIN                   = 731.4               $Nominal wheel load
$-------------------------------------------------------------------scaling_coefficients                                                           
[SCALING_COEFFICIENTS]                                                                                                                             
LFZO                     = 1.0                  $Scale factor of nominal (rated) load
LCX	=	1.0	$Scale factor of Fx shape factor
LMUX	=	1.0	$Scale factor of Fx peak friction coefficient
LEX	=	1.0	$Scale factor of Fx curvature factor
LKX	=	1.0	$Scale factor of Fx slip stiffness
LHX	=	0.035	$Scale factor of Fx horizontal shift
LVX	=	1.0	$Scale factor of Fx vertical shift
LGAX	=	1.0	$Scale factor of camber for Fx
LCY	=	1.0	$Scale factor of Fy shape factor 1.0
LMUY	=	1.0	$Scale factor of Fy peak friction coefficient
LEY	=	1.0	$Scale factor of Fy curvature factor 1.0
LKY	=	1.0	$Scale factor of Fy cornering stiffness
LHY	=	0.4	$Scale factor of Fy horizontal shift
LVY	=	1.0	$Scale factor of Fy vertical shift
LGAY	=	1.0	$Scale factor of camber for Fy
LTR	=	1.0	$Scale factor of Peak of pneumatic trail
LRES	=	1.0	$Scale factor for offset of residual torque
LGAZ	=	1.0	$Scale factor of camber for Mz
LXAL	=	1.0	$Scale factor of alpha influence on Fx
LYKA	=	1.0	$Scale factor of kappa influence on Fy
LVYKA	=	1.0	$Scale factor of kappa induced Fy
LS	=	1.0	$Scale factor of Moment arm of Fx
LSGKP	=	1.0	$Scale factor of Relaxation length of Fx
LSGAL	=	1.0	$Scale factor of Relaxation length of Fy
LGYR	=	1.0	$Scale factor of gyroscopic torque
LMX	=	1.0	$Scale factor of overturning couple
LVMX	=	1.0	$Scale factor of Mx vertical shift
LMY	=	1.0	$Scale factor of rolling resistance torque
LIP	=	1.0	$Scale factor of inflation pressure
LCZ	=	1.0	$Scale factor of vertical tire stiffness
LKYG	=	1.0	$Scale factor of camber stiffness
$--------------------------------------------------------------longitudinal_coefficients                                                                    
[LONGITUDINAL_COEFFICIENTS]                                                                                                                        
PCX1                     = 0.76263                $Shape factor Cfx for longitudinal force
PDX1                     = 2.92060               $Longitudinal friction Mux at Fznom
PDX2                     = -0.16135              $Variation of friction Mux with load
PDX3                     = 12.2142		        $Variation of friction Mux with camber -2.2142e-005
PEX1                     = -6.48045              $Longitudinal curvature Efx at Fznom
PEX2                     = -0.04203             $Variation of curvature Efx with load -0.12336
PEX3                     = -0.10453            $Variation of curvature Efx with load squared -0.03448
PEX4                     = -0.03051         $Factor in curvature Efx while driving
PKX1                     = -42.84337               $Longitudinal slip stiffness Kfx/Fz at Fznom
PKX2                     = -31.42072               $Variation of slip stiffness Kfx/Fz with load
PKX3                     = -0.96548              $Exponent in slip stiffness Kfx/Fz with load
PHX1                     = 0.02034          $Horizontal shift Shx at Fznom
PHX2                     = 0.02189         $Variation of shift Shx with load
PVX1                     = 0.09263          $Vertical shift Svx/Fz at Fznom
PVX2                     = -0.03687          $Variation of shift Svx/Fz with load
PPX1                     = 0.0                  
PPX2                     = 0.0                  
PPX3                     = 0.0                  
PPX4                     = 0.0                  
RBX1                     = 6.38748               $Slope factor for combined slip Fx reduction
RBX2                     = 6.22924              $Variation of slope Fx reduction with kappa
RCX1                     = 1.66382              $Shape factor for combined slip Fx reduction
REX1                     = 0.00293               $Curvature factor of combined Fx
REX2                     = -0.21950           $Curvature factor of combined Fx with load
RHX1                     = 0.0            $Shift factor for combined slip Fx reduction
PTX1                     = 0.0                  $Relaxation length SigKap0/Fz at Fznom
PTX2                     = 0.0             $Variation of SigKap0/Fz with load
PTX3                     = 0.0               $Variation of SigKap0/Fz with exponent of load
PTX4                     = 0.0                  
$---------------------------------------------------------------overturning_coefficients                                                                    
[OVERTURNING_COEFFICIENTS]                                                                                                                                  
QSX1                     = 0.0                  $Lateral force induced overturning moment
QSX2                     = 0.0                  $Camber induced overturning couple
QSX3                     = 0.0                  $Fy induced overturning couple
QSX4                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection
QSX5                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection
QSX6                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection
QSX7                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by inclination
QSX8                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by lateral force
QSX9                     = 0.0                  $Fz induced overturning couple due to lateral tire deflection by lateral force
QSX10                    = 0.0                  $Inclination induced overturning couple, load dependency
QSX11                    = 0.0                  $load dependency inclination induced overturning couple
QPX1                     = 0.0                  $Variation of camber effect with pressure
$-------------------------------------------------------------------lateral_coefficients                                                                    
[LATERAL_COEFFICIENTS]                                                                                                                                      
PCY1                     = 0.54633        $Shape factor Cfy for lateral forces
PDY1                     = -3.95115        $Lateral friction Muy
PDY2                     = 0.26549      $Variation of friction Muy with load
PDY3                     = 13.92153        $Variation of friction Muy with squared camber
PEY1                     = -2.14047      $Lateral curvature Efy at Fznom
PEY2                     = 1.18836     $Variation of curvature Efy with load
PEY3                     = -0.20017      $Zero order camber dependency of curvature Efy
PEY4                     = -0.50875       $Variation of curvature Efy with camber
PKY1                     = 76.25967       $Maximum value of stiffness Kfy/Fznom
PKY2                     = 2.71015        $Load at which Kfy reaches maximum value
PKY3                     = 17.39495      $Variation of Kfy/Fznom with camber
PHY1                     = 0.00142     $Horizontal shift Shy at Fznom
PHY2                     = -0.00234   $Variation of shift Shy with load
PHY3                     = -0.16334       $Variation of shift Shy with camber
PVY1                     = -0.03083      $Vertical shift in Svy/Fz at Fznom
PVY2                     = 0.04426     $Variation of shift Svy/Fz with load
PVY3                     = 2.11056      $Variation of shift Svy/Fz with camber
PVY4                     = -0.91647      $Variation of shift Svy/Fz with camber and load
PPY1                     = 0.0                  $Variation of  max. stiffness Kfy/Fznom with pressure
PPY2                     = 0.0                  $Variation of load at max. Kfy with pressure
PPY3                     = 0.0                  $Variation of friction Muy with pressure
PPY4                     = 0.0                  $Variation of friction Muy with pressure squared
RBY1                     = 0.0       $Slope factor for combined Fy reduction
RBY2                     = 0.0        $Variation of slope Fy reduction with alpha
RBY3                     = 0.0      $Shift term for alpha in slope Fy reduction
RCY1                     = 0.0        $Shape factor for combined Fy reduction
REY1                     = 0.0     $Curvature factor of combined Fy
REY2                     = 0.0    $Curvature factor of combined Fy with load
RHY1                     = 0.0    $Shift factor for combined Fy reduction
RHY2                     = 0.0    $Shift factor for combined Fy reduction with load
RVY1                     = 0.0    $Kappa induced side force Svyk/Muy*Fz at Fznom
RVY2                     = 0.0    $Variation of Svyk/Muy*Fz with load
RVY3                     = 0.0   $Variation of Svyk/Muy*Fz with camber
RVY4                     = 0.0       $Variation of Svyk/Muy*Fz with alpha
RVY5                     = 0.0         $Variation of Svyk/Muy*Fz with kappa
RVY6                     = 0.0        $Variation of Svyk/Muy*Fz with atan(kappa)
PTY1                     = 0.0               $Peak value of relaxation length SigAlp0/R0 2.1439        
PTY2                     = 0.0               $Value of Fz/Fznom where SigAlp0 is extreme         
PTY3                     = 0.0                  $Artificial damping for low speed
$-------------------------------------------------------------------rolling_coefficients                                                           
[ROLLING_COEFFICIENTS]                                                                                                                                                                                     
QSY1                     = 0.0                 $Rolling resistance torque coefficient
QSY2                     = 0.0                  $Rolling resistance torque depending on Fx
QSY3                     = 0.0                  $Rolling resistance torque depending on speed
QSY4                     = 0.0                  $Rolling resistance torque depending on speed ^4
$------------------------------------------------------------------aligning_coefficients                                                           
[ALIGNING_COEFFICIENTS]                                                                                                                                     
QBZ1                     = 1.49016        $Trail slope factor for trail Bpt at Fznom
QBZ2                     = 0.43729      $Variation of slope Bpt with load
