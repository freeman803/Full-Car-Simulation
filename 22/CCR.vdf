ANGLE = 'RADIAN'
FORCE = 'NEWTON'
MASS = 'KILOGRAM'
TIME = 'SECOND'
$----------------------------------------------------------------GLOBAL_SETTINGS
[GLOBAL_SETTINGS]
MODEL_TYPE = 'CAR_STANDARD'
$------------------------------------------------------------------------STARTUP
[STARTUP]
INITIAL_SPEED = 15
INITIAL_STEERING = 0
INITIAL_THROTTLE = 0
INITIAL_BRAKING = 0
INITIAL_BRAKING2 = 0
INITIAL_GEAR = 1
INITIAL_CLUTCH = 0
