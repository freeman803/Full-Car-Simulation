$----------------------------------------------------------------CLUTCH_STANDARD
[CLUTCH_STANDARD]
MAX_VALUE = 1
MIN_VALUE = 0
$----------------------------------------------------------------MAINTAIN_SIGNAL
[MAINTAIN_SIGNAL]
TYPE = 'MAINTAIN'
$-----------------------------------------------------------------ENTRY_DISTANCE
[ENTRY_DISTANCE]
TASK = 'STANDARD'
CONTROLLER_SETTINGS = 'CONTROLLER_STANDARD'
(STEERING)
CONTROLLER_NAME = 'MANEUVER_1_STEERING'
(THROTTLE)
CONTROLLER_NAME = 'THROTTLE_1'
(BRAKING)
CONTROLLER_NAME = 'MANEUVER_1_BRAKING'
(BRAKING2)
CONTROLLER_NAME = 'MANEUVER_1_BRAKING2'
(GEAR)
CONTROLLER_NAME = 'MANEUVER_1_GEAR'
(CLUTCH)
CONTROLLER_NAME = 'MANEUVER_1_CLUTCH'
(OPTIONS)
FOLLOW_TARGET_SPEED = 'TRUE'
SPEED_MAP_ABS_TIME = 'FALSE'
CONNECT_PATH = 'FALSE'
SPEED_MAP_GLOBAL_S = 'FALSE'
(MACHINE)
PATH = 'PATH_1'
SPEED = 'MANEUVER_1_SPEED'
(END_CONDITIONS)
{name  }
 'DISTANCE'
$------------------------------------------------------------MANEUVER_1_STEERING
[MANEUVER_1_STEERING]
CONTROLLER_DATA = 'STEERING'
METHOD = 'MACHINE'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0.1
$-------------------------------------------------------------MANEUVER_1_BRAKING
[MANEUVER_1_BRAKING]
CONTROLLER_DATA = 'BRAKING'
METHOD = 'MACHINE'
SMOOTHING_ACTIVE = 'TRUE'
SMOOTHING_TIME = 0.1
$------------------------------------------------------------MANEUVER_1_BRAKING2
[MANEUVER_1_BRAKING2]
